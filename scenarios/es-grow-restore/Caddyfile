# Requires Caddy 2.11.1 or later (CVE-2026-27587). The {$VAR:default} values let
# the same file run in compose, in CI validation and in the proxy-only test
# harness; compose always sets ES_SITE_ADDRESS and ALLOWED_CIDRS. ES_UPSTREAMS is a
# space-separated host:port list; Caddy splits it into one upstream per item.
{
	admin {$CADDY_ADMIN:localhost:2019}
	servers {
		protocols h1 h2
	}
}

{$ES_SITE_ADDRESS:es.localhost} {
	log

	# route keeps the written order. Without it Caddy sorts directives and runs
	# handle and reverse_proxy before abort, so the IP allowlist would not
	# protect the proxied paths.
	route {
		# remote_ip is the immediate TCP peer. Behind another proxy or Docker's
		# userland proxy that is not the client, and this check means nothing.
		@outside not remote_ip {$ALLOWED_CIDRS:127.0.0.1/32}
		abort @outside

		request_body {
			max_size 20MB
		}

		# Matched against the raw request URI, because reverse_proxy forwards the
		# raw path: path and path_regexp see a decoded, dot-cleaned path, so
		# /secret/../app-a/_search would match them and still reach the node as
		# written. Any encoding, dot segment, double slash, upper case, comma,
		# wildcard, date math or remote-cluster prefix fails the pattern and
		# gets the 404 below.
		# This allowlist is a speed bump: a _bulk body can still name any index,
		# and only the Elasticsearch role decides what the caller may touch.
		@app_read {
			method GET POST
			expression `{http.request.uri}.matches("^/app-[a-z0-9][a-z0-9-]*/_(search|count)([?].*)?$")`
		}
		@app_write {
			method POST PUT
			expression `{http.request.uri}.matches("^/app-[a-z0-9][a-z0-9-]*/_bulk([?].*)?$")`
		}

		# A stopped node fails at connect time, and Caddy retries a failed
		# connect on another node for any method, because nothing reached the
		# node. A request that did reach a node is retried only if it is a GET,
		# so a _bulk is never sent twice. fail_duration keeps a dead node out of
		# rotation for 30s after one failure.
		reverse_proxy @app_read {$ES_UPSTREAMS:es01:9200 es02:9200 es03:9200} {
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 30s
			# Elasticsearch does not honour this header; dropping it only keeps
			# the upstream request equal to what the method matcher saw.
			header_up -X-HTTP-Method-Override
		}
		reverse_proxy @app_write {$ES_UPSTREAMS:es01:9200 es02:9200 es03:9200} {
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 30s
			header_up -X-HTTP-Method-Override
		}

		respond 404
	}
}
