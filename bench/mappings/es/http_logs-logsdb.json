{
  "settings": {
    "index.number_of_shards": 1,
    "index.number_of_replicas": 0,
    "index.requests.cache.enable": false,
    "index.mode": "logsdb",
    "index.mapping.source.mode": "stored",
    "index.sort.field": [
      "@timestamp"
    ],
    "index.sort.order": [
      "desc"
    ]
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "@timestamp": {
        "type": "date",
        "format": "epoch_second"
      },
      "clientip": {
        "type": "ip"
      },
      "request": {
        "type": "text"
      },
      "status": {
        "type": "integer"
      },
      "size": {
        "type": "integer"
      }
    }
  }
}
